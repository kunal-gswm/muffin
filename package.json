{
  "name": "streambert-backend",
  "version": "1.0.0",
  "description": "Standalone REST API extracted from Streambert — local-only media metadata & stream aggregator",
  "type": "module",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "nodemon server.js",
    "dev:desktop": "electron .",
    "start": "node server.js",
    "test": "node --test test/unit.test.js",
    "test:smoke": "cross-env SMOKE=1 node --test test/smoke.test.js",
    "build:exe": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jimp": "^0.16.13",
    "socket.io": "^4.8.3"
  },
  "optionalDependencies": {
    "puppeteer": "^23.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "build": {
    "appId": "com.muffintv.app",
    "productName": "Muffin TV",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.exe"
    },
    "extraResources": [
      "downloader.bat",
      "N_m3u8DL-RE/**/*"
    ],
    "files": [
      "**/*",
      "!dist-electron",
      "!scratch",
      "!test"
    ]
  }
}
