# Required — server won't start without this
TMDB_API_KEY=

# Server
PORT=3939

# Optional — subtitle search disabled without these
SUBDL_API_KEY=
WYZIE_API_KEY=

# Optional — download feature disabled without this
# Must be the EXACT absolute path to the downloader binary (not a folder)
DOWNLOADER_PATH=

# Optional — feature flags
ENABLE_ANIME=true

# Optional — Puppeteer tuning (stream resolver)
PUPPETEER_MAX_PAGES=2
PUPPETEER_MAX_REQUESTS=50
PUPPETEER_PAGE_TIMEOUT=30000
DOWNLOAD_DIR=
PREFERRED_QUALITY=1080p
DEFAULT_SOURCE=vidsrc
